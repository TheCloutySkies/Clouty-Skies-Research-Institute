</script>
<!-- Interactive Logic & Animations -->
<script>
	// Initialize Icons
	lucide.createIcons();

	// Scroll Animations Observer
	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('visible');
			}
		});
	}, { threshold: 0.15 });

	document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));

	// Interactive Scale Logic
	const tierData = [
		{
			max: 5,
			title: "Regular Person",
			desc: "Baseline demographic. Minimal to no adoption of external cultural markers. Geographic isolation remains intact.",
			bars: { nwal: '10%', wec: '5%', bsa: '0%', ffp: '0%' }
		},
		{
			max: 10,
			title: "Low Risk Individual",
			desc: "Passive consumption of media influences aesthetic choices marginally. Low probability of organic field encounters.",
			bars: { nwal: '25%', wec: '15%', bsa: '10%', ffp: '5%' }
		},
		{
			max: 15,
			title: "SoundCloud Rapper",
			desc: "Visible integration of aesthetic markers. Occasional use of regional vernacular. Noticeable presence in localized retail environments.",
			bars: { nwal: '50%', wec: '40%', bsa: '60%', ffp: '30%' }
		},
		{
			max: 20,
			title: "Your Schizophrenic White Uncle",
			desc: "High commitment to the persona. Frequent employment in fast-casual dining or localized retail. High likelihood of public audio broadcasting.",
			bars: { nwal: '80%', wec: '75%', bsa: '90%', ffp: '65%' }
		},
		{
			max: 25,
			title: "WiggerMaxxing",
			desc: "Peak WiggerFactor. Complete integration of aesthetic and linguistic markers. Extremely high probability of complimentary consumables via networking.",
			bars: { nwal: '100%', wec: '95%', bsa: '100%', ffp: '90%' }
		}
	];

	function updateDashboard(value) {
		document.getElementById('score-display').textContent = value;
		
		// Find appropriate tier
		let currentTier = tierData[0];
		for(let i = 0; i < tierData.length; i++) {
			if(value <= tierData[i].max) {
				currentTier = tierData[i];
				break;
			}
		}

		// Update Text
		document.getElementById('tier-title').textContent = currentTier.title;
		document.getElementById('tier-desc').textContent = currentTier.desc;

		// Update Bars
		document.getElementById('bar-nwal').style.width = currentTier.bars.nwal;
		document.getElementById('bar-wec').style.width = currentTier.bars.wec;
		document.getElementById('bar-bsa').style.width = currentTier.bars.bsa;
		document.getElementById('bar-ffp').style.width = currentTier.bars.ffp;
	}

	// Initialize dashboard on load
	updateDashboard(13);
</script>
