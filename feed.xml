<!-- Icons -->
<script src="https://unpkg.com/lucide@latest"></script>
<!-- Configuration & Custom CSS -->
<script>
	tailwind.config = {
		theme: {
			extend: {
				fontFamily: {
					serif: ['"Playfair Display"', 'Georgia', 'serif'],
					sans: ['"Inter"', 'system-ui', 'sans-serif'],
				},
				colors: {
					nobel: {
						gold: '#C5A059',
